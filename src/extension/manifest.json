{
  "manifest_version": 3,
  "name": "RFC Editor Viewer",
  "description": "Enhances RFC readability on rfc-editor.org with local, runtime-configurable formatting controls.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.rfc-editor.org/*"],
  "action": {
    "default_title": "RFC Viewer",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.rfc-editor.org/*"],
      "js": ["content-script.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
